{
  "name": "gitlab-cr-opencode",
  "displayName": "GitLab CR + opencode",
  "description": "Show code review notes from a self-hosted GitLab merge request inside VS Code, get opencode fix and reply suggestions, apply them, and run a self code review.",
  "version": "0.1.0",
  "publisher": "crcode",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "gitlab",
    "code review",
    "merge request",
    "opencode",
    "ai"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.git",
    "onView:gitlabCr.threads"
  ],
  "contributes": {
    "configuration": {
      "title": "GitLab CR + opencode",
      "properties": {
        "gitlabCr.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of your self-hosted GitLab, for example `https://gitlab.example.com`. When empty, the extension uses the host of the `origin` remote."
        },
        "gitlabCr.projectPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "GitLab project path (for example `group/subgroup/project`) or numeric project ID. When empty, the extension reads it from the git remote."
        },
        "gitlabCr.remoteName": {
          "type": "string",
          "default": "origin",
          "description": "Git remote that points to the GitLab project."
        },
        "gitlabCr.strictSSL": {
          "type": "boolean",
          "default": true,
          "description": "Verify the TLS certificate of the GitLab server. Set to false only for servers with self-signed certificates that you trust."
        },
        "gitlabCr.showResolved": {
          "type": "boolean",
          "default": false,
          "description": "Also show resolved discussions."
        },
        "gitlabCr.opencode.path": {
          "type": "string",
          "default": "opencode",
          "description": "Path to the opencode executable."
        },
        "gitlabCr.opencode.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model for opencode in the format `provider/model`. When empty, opencode uses its own default."
        },
        "gitlabCr.opencode.agent": {
          "type": "string",
          "default": "plan",
          "markdownDescription": "opencode agent to use. The default `plan` agent can read the repository but cannot edit files. The extension applies edits itself, after you approve them."
        },
        "gitlabCr.opencode.timeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "description": "Maximum time for one opencode request."
        },
        "gitlabCr.fixAll.concurrency": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Number of opencode requests that can run at the same time during 'Fix All CR Notes'."
        },
        "gitlabCr.fixAll.confirm": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before 'Fix All CR Notes' applies the fixes."
        },
        "gitlabCr.selfReview.baseBranch": {
          "type": "string",
          "default": "",
          "markdownDescription": "Branch to compare against for the self code review. When empty, the extension uses the target branch of the merge request, or `main`."
        },
        "gitlabCr.selfReview.maxDiffKb": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "description": "Maximum diff size (in KB) sent to opencode for the self code review. A larger diff is truncated."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitlabCr",
          "title": "GitLab CR",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitlabCr": [
        {
          "id": "gitlabCr.threads",
          "name": "Review Notes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitlabCr.threads",
        "contents": "No review notes loaded.\n[Refresh CR Notes](command:gitlabCr.refresh)\n[Set GitLab Access Token](command:gitlabCr.setToken)\n[Self Code Review](command:gitlabCr.selfReview)"
      }
    ],
    "commands": [
      { "command": "gitlabCr.refresh", "title": "Refresh CR Notes", "category": "GitLab CR", "icon": "$(refresh)" },
      { "command": "gitlabCr.setToken", "title": "Set GitLab Access Token", "category": "GitLab CR", "icon": "$(key)" },
      { "command": "gitlabCr.openInBrowser", "title": "Open Merge Request in Browser", "category": "GitLab CR", "icon": "$(link-external)" },
      { "command": "gitlabCr.fixAll", "title": "Fix All CR Notes", "category": "GitLab CR", "icon": "$(wand)" },
      { "command": "gitlabCr.selfReview", "title": "Self Code Review", "category": "GitLab CR", "icon": "$(checklist)" },
      { "command": "gitlabCr.clearSelfReview", "title": "Clear Self Review Findings", "category": "GitLab CR", "icon": "$(clear-all)" },
      { "command": "gitlabCr.suggestFix", "title": "Suggest Fix (opencode)", "category": "GitLab CR", "icon": "$(lightbulb)" },
      { "command": "gitlabCr.applyFix", "title": "Apply Fix", "category": "GitLab CR", "icon": "$(check)" },
      { "command": "gitlabCr.reply", "title": "Reply", "category": "GitLab CR", "icon": "$(comment)" },
      { "command": "gitlabCr.suggestReply", "title": "Suggest Reply (opencode)", "category": "GitLab CR", "icon": "$(sparkle)" },
      { "command": "gitlabCr.sendDraft", "title": "Send Reply", "category": "GitLab CR", "icon": "$(send)" },
      { "command": "gitlabCr.editDraft", "title": "Edit Reply", "category": "GitLab CR", "icon": "$(edit)" },
      { "command": "gitlabCr.discardDraft", "title": "Discard", "category": "GitLab CR", "icon": "$(trash)" },
      { "command": "gitlabCr.saveDraft", "title": "Save", "category": "GitLab CR" },
      { "command": "gitlabCr.cancelDraftEdit", "title": "Cancel", "category": "GitLab CR" },
      { "command": "gitlabCr.toggleResolved", "title": "Resolve / Unresolve", "category": "GitLab CR", "icon": "$(pass)" },
      { "command": "gitlabCr.postFinding", "title": "Post Finding to Merge Request", "category": "GitLab CR", "icon": "$(cloud-upload)" },
      { "command": "gitlabCr.dismissFinding", "title": "Dismiss Finding", "category": "GitLab CR", "icon": "$(close)" },
      { "command": "gitlabCr.openThread", "title": "Open Note", "category": "GitLab CR" }
    ],
    "menus": {
      "view/title": [
        { "command": "gitlabCr.refresh", "when": "view == gitlabCr.threads", "group": "navigation@1" },
        { "command": "gitlabCr.fixAll", "when": "view == gitlabCr.threads", "group": "navigation@2" },
        { "command": "gitlabCr.selfReview", "when": "view == gitlabCr.threads", "group": "navigation@3" },
        { "command": "gitlabCr.openInBrowser", "when": "view == gitlabCr.threads", "group": "navigation@4" },
        { "command": "gitlabCr.clearSelfReview", "when": "view == gitlabCr.threads", "group": "more@1" },
        { "command": "gitlabCr.setToken", "when": "view == gitlabCr.threads", "group": "more@2" }
      ],
      "view/item/context": [
        { "command": "gitlabCr.suggestFix", "when": "view == gitlabCr.threads && viewItem =~ /\\bhasFile\\b/", "group": "inline@1" },
        { "command": "gitlabCr.applyFix", "when": "view == gitlabCr.threads && viewItem =~ /\\bhasFix\\b/", "group": "inline@2" },
        { "command": "gitlabCr.suggestReply", "when": "view == gitlabCr.threads && viewItem =~ /\\bsrc-gitlab\\b/", "group": "inline@3" },
        { "command": "gitlabCr.reply", "when": "view == gitlabCr.threads && viewItem =~ /\\bsrc-gitlab\\b/", "group": "inline@4" },
        { "command": "gitlabCr.postFinding", "when": "view == gitlabCr.threads && viewItem =~ /\\bsrc-self\\b/", "group": "inline@5" },
        { "command": "gitlabCr.dismissFinding", "when": "view == gitlabCr.threads && viewItem =~ /\\bsrc-self\\b/", "group": "inline@6" },
        { "command": "gitlabCr.toggleResolved", "when": "view == gitlabCr.threads && viewItem =~ /\\bresolvable\\b/", "group": "z@1" }
      ],
      "comments/commentThread/title": [
        { "command": "gitlabCr.suggestFix", "when": "commentController == gitlabCr && commentThread =~ /\\bhasFile\\b/", "group": "navigation@1" },
        { "command": "gitlabCr.applyFix", "when": "commentController == gitlabCr && commentThread =~ /\\bhasFix\\b/", "group": "navigation@2" },
        { "command": "gitlabCr.suggestReply", "when": "commentController == gitlabCr && commentThread =~ /\\bsrc-gitlab\\b/", "group": "navigation@3" },
        { "command": "gitlabCr.toggleResolved", "when": "commentController == gitlabCr && commentThread =~ /\\bresolvable\\b/", "group": "navigation@4" },
        { "command": "gitlabCr.postFinding", "when": "commentController == gitlabCr && commentThread =~ /\\bsrc-self\\b/", "group": "navigation@5" },
        { "command": "gitlabCr.dismissFinding", "when": "commentController == gitlabCr && commentThread =~ /\\bsrc-self\\b/", "group": "navigation@6" }
      ],
      "comments/commentThread/context": [
        { "command": "gitlabCr.reply", "when": "commentController == gitlabCr && commentThread =~ /\\bsrc-gitlab\\b/", "group": "inline@1" }
      ],
      "comments/comment/title": [
        { "command": "gitlabCr.applyFix", "when": "commentController == gitlabCr && comment == suggestion", "group": "inline@1" },
        { "command": "gitlabCr.sendDraft", "when": "commentController == gitlabCr && comment == draft", "group": "inline@1" },
        { "command": "gitlabCr.editDraft", "when": "commentController == gitlabCr && comment == draft", "group": "inline@2" },
        { "command": "gitlabCr.discardDraft", "when": "commentController == gitlabCr && comment =~ /^(draft|suggestion)$/", "group": "inline@3" }
      ],
      "comments/comment/context": [
        { "command": "gitlabCr.saveDraft", "when": "commentController == gitlabCr && comment == draft", "group": "inline@1" },
        { "command": "gitlabCr.cancelDraftEdit", "when": "commentController == gitlabCr && comment == draft", "group": "inline@2" }
      ],
      "commandPalette": [
        { "command": "gitlabCr.applyFix", "when": "false" },
        { "command": "gitlabCr.sendDraft", "when": "false" },
        { "command": "gitlabCr.editDraft", "when": "false" },
        { "command": "gitlabCr.discardDraft", "when": "false" },
        { "command": "gitlabCr.saveDraft", "when": "false" },
        { "command": "gitlabCr.cancelDraftEdit", "when": "false" },
        { "command": "gitlabCr.postFinding", "when": "false" },
        { "command": "gitlabCr.dismissFinding", "when": "false" },
        { "command": "gitlabCr.openThread", "when": "false" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npx -y @vscode/vsce@3 package --skip-license --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "typescript": "^5.4.0"
  }
}
